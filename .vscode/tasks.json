{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build PlatformIO",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "release_RP2040"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Upload JLINK",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "upload_JLINK_RP2040",
                "upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Upload ATMEL",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "upload_ATMEL_RP2040",
                "upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Upload USB",
            "type": "shell",
            "command": "scripts/OpenKNX-Build.ps1",
            "args": [
                "upload_USB_RP2040",
                "upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "OpenKNXproducer",
            "type": "shell",
            "command": "${env:USERPROFILE}\\bin\\OpenKNXproducer.exe",
            "args": [
                "create",
                "--Debug",
                "--HeaderFileName",
                "include/knxprod.h",
                "src/GardenControl"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Generate Dependencies.txt",
            "type": "shell",
            "command": "lib/OGM-Common/scripts/setup/reusable/Build-Dependencies.ps1",
            "args": [],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Build-Release",
            "type": "shell",
            "command": "scripts/Build-Release.ps1",
            "args": [],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "resolve platformio.ini",
            "type": "shell",
            "command": "~/.platformio/penv/Scripts/pio",
            "args": [
                "project",
                "config",
                ">platformio.ini.full.txt"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Debug-XML in Navigator kopieren",
            "type": "shell",
            "command": "Copy-Item -Path '${workspaceFolder}/src/GardenControl.knxprod' -Destination '${workspaceFolder}/../OpenKNX-XML-Navigator/data/GardenControl.knxprod' -Force",
            "problemMatcher": []
        },
        {
            "label": "OpenKNXproducer GardenControl bauen + im Navigator anzeigen",
            "dependsOrder": "sequence",
            "dependsOn": [
                "OpenKNXproducer",
                "Debug-XML in Navigator kopieren"
            ],
            "problemMatcher": []
        },
        {
            "label": "OpenKNX XML Navigator starten",
            "type": "shell",
            "command": "npm start",
            "options": {
                "cwd": "${workspaceFolder}/../OpenKNX-XML-Navigator",
                "env": {
                    "OPENKNX_XML_NAVIGATOR_DEFAULT_SOURCE": "data/GardenControl.knxprod"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^unmatchable^"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "(listening|4173|running)"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "OpenKNX XML Navigator (mit Browser)",
            "dependsOn": [
                "OpenKNX XML Navigator starten"
            ],
            "dependsOrder": "sequence",
            "type": "shell",
            "command": "Start-Sleep -Seconds 2; Start-Process 'http://localhost:4173'",
            "problemMatcher": []
        }
    ]
}